#!/usr/bin/env bash
# .githooks/pre-commit — MAIN-Repo: laesst die Checks der betroffenen Sprache
# automatisch laufen, statt sie "von Hand" zu fahren.
#
#   llm-proxies/glm2api/**.py|toml  -> ruff check + mypy src   (Python, Vendor)
#   infra/**.py + Root-Python-Config -> ruff check + mypy       (MAIN-eigenes Python)
#   Makefile / .githooks/pre-commit  -> Kopplung Makefile <-> Hook pruefen
#   llm-proxies/antigravity-proxy/** -> go vet + gofmt -l       (Go)
#   infra/**.js                      -> node --check            (MAIN-eigenes JS)
#   Makefile/pyproject/coverage-floor/checks.yml -> Gate-Claims vs. Config
#   **.sh                            -> shellcheck gegen Baseline (PLAN Stufe 4)
#
# zerokeys `pnpm lint` laeuft hier bewusst NICHT: das braucht node_modules und
# ist der eigene, handgestartete `pnpm precommit` (llm-proxies/zerokey/).
#
# Drei Eigenschaften, an denen hier NICHTS geaendert werden darf:
#   1. Der Hook fasst den Index nicht an (kein `git add`, kein `--fix`/`--write`
#      an den Quelldateien). In diesem geteilten Repo hat ein Hook mit `git add`
#      schon fremde, parallel gestagte Aenderungen mitcommittet
#      (infrastructure.md, Changelog 2026-09-29). Der Hook liest nur und bricht ab.
#   2. Er laeuft nur, wenn gestagte Dateien die jeweilige Sprache betreffen —
#      Commits an Doku/Infra werden nicht ausgebremst.
#   3. Nichts ohne Timer (AGENTS.md §4) — alles laeuft ueber timeout.sh.
#
# Aktiviert per `git config core.hooksPath .githooks` (macht .devcontainer/setup.sh).
# Notausstieg: `git commit --no-verify`.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
TIMEOUT="$ROOT/infra/scripts/timeout.sh"
[ -x "$TIMEOUT" ] || { echo "[pre-commit] WARN: $TIMEOUT fehlt — Checks uebersprungen." >&2; exit 0; }
run() { "$TIMEOUT" run "$1" "${@:2}"; }

# Gestagte, hinzugefuegte/geaenderte Dateien (Loeschungen interessieren nicht).
changed="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)"
[ -n "$changed" ] || exit 0

fail=0

# --- 1) glm2api (Python): ruff + mypy -------------------------------------
# hier-string statt Pipe: `printf | grep -q` kann unter pipefail per SIGPIPE
# faelschlich rot werden (grep -q beendet die Pipe vorzeitig).
if grep -qE '^llm-proxies/glm2api/.*\.(py|toml)$' <<< "$changed"; then
  echo "[pre-commit] glm2api (Python) geaendert -> ruff + mypy..."
  cd "$ROOT/llm-proxies/glm2api" || exit 0
  run 120 uv run ruff check . || { echo "[pre-commit] ruff hat Befunde — Commit abgebrochen." >&2; fail=1; }
  run 180 uv run mypy src      || { echo "[pre-commit] mypy hat Befunde — Commit abgebrochen." >&2; fail=1; }
fi

# --- 1b) MAIN-eigenes Python (infra/ + Root-Umgebung): ruff + mypy -------
# Ab 2026-10-02 (PLAN Stufe 3) hat infra/scripts/*.py eine eigene Umgebung
# ueber die Root-pyproject.toml. Vorher war das die einzige Python-Flaeche ganz
# ohne Werkzeug. Zweite Umgebung, kein Mix: llm-proxies/glm2api nimmt weiter
# ihre eigene, weil uv immer die naechstgelegene pyproject.toml waehlt.
if grep -qE '^infra/(scripts|tests)/.*\.py$|^pyproject\.toml$|^uv\.lock$' <<< "$changed"; then
  echo "[pre-commit] MAIN-Python geaendert -> ruff + mypy (infra/)..."
  cd "$ROOT" || exit 0
  run 120 uv run ruff check . || { echo "[pre-commit] ruff (infra/) hat Befunde — Commit abgebrochen." >&2; fail=1; }
  run 180 uv run mypy         || { echo "[pre-commit] mypy (infra/) hat Befunde — Commit abgebrochen." >&2; fail=1; }
fi

# --- 1c) Einstiegspunkt geaendert: Makefile <-> Hook-Kopplung pruefen ------
# Befund vom 2026-10-02: ein reiner `Makefile`-Fehler kam durch diesen Hook
# durch, weil er nur Quellsprachen triggert. Der CI-Negativtest hat es gezeigt
# (PR #23). Der Check ist inhaltlich derselbe wie „Makefile deckt Hook ab“ in
# verify-codespace.sh — der muss ihn hier trotzdem wiederholen, weil ein Hook
# den noch nicht existierenden Commit nicht fragen kann. Die kanonische Fassung
# bleibt der Verify-Check.
if grep -qE '^(Makefile|\.githooks/pre-commit)$' <<< "$changed"; then
  echo "[pre-commit] Einstiegspunkt geaendert -> Kopplung Makefile <-> Hook..."
  cd "$ROOT" || exit 0
  mmiss=""
  for tool in "ruff check" "mypy src" "vet ./..." "gofmt -l" "node --check"; do
    grep -qF "$tool" Makefile            || mmiss="$mmiss make:[$tool]"
    grep -qF "$tool" .githooks/pre-commit || mmiss="$mmiss hook:[$tool]"
  done
  if [ -n "$mmiss" ]; then
    echo "[pre-commit] Makefile und Hook nennen verschiedene Kommandos ->$mmiss" >&2
    echo "              (kanonische Pruefung: verify-codespace.sh, Check 'Makefile deckt Hook ab')" >&2
    fail=1
  fi
fi

# --- 2) antigravity-proxy (Go): go vet + gofmt ----------------------------
if grep -qE '^llm-proxies/antigravity-proxy/.*\.go$|^llm-proxies/antigravity-proxy/(go\.mod|go\.sum)$' <<< "$changed"; then
  echo "[pre-commit] antigravity-proxy (Go) geaendert -> go vet + gofmt..."
  GO=""
  for c in /usr/local/go/bin/go "$(command -v go 2>/dev/null)"; do
    [ -n "$c" ] && [ -x "$c" ] && { GO="$c"; break; }
  done
  if [ -z "$GO" ]; then
    echo "[pre-commit] WARN: kein go gefunden — Go-Check uebersprungen." >&2
  else
    cd "$ROOT/llm-proxies/antigravity-proxy" || exit 0
    run 180 "$GO" vet ./... || { echo "[pre-commit] go vet rot — Commit abgebrochen." >&2; fail=1; }
    GOFMT=/usr/local/go/bin/gofmt
    [ -x "$GOFMT" ] || GOFMT="$(command -v gofmt 2>/dev/null || true)"
    if [ -n "$GOFMT" ] && [ -x "$GOFMT" ]; then
      # READ-ONLY: -l listet nur (ein Verifier darf nichts schreiben, `go fmt` taete das).
      un="$("$GOFMT" -l . 2>/dev/null | grep -v '^vendor/' || true)"
      [ -z "$un" ] || { echo "[pre-commit] gofmt noetig: $un" >&2; fail=1; }
    fi
  fi
fi

# --- 2b) Port-Labels: ports.sh ist die einzige Quelle ---------------------
# Ein neuer gebundener oder weitergeleiteter Port ohne Label laeuft und zeigt
# in `ports.sh` als "sonstiger Prozess". Der Check liest ports.sh und die
# Deklarationen in den Start-Skripten plus devcontainer.json.
if grep -qE '^infra/scripts/(ports|port-drift-check)\.(sh|py)$|^\.devcontainer/(devcontainer\.json|.*\.sh)$|^llm-proxies/(scripts|zerokey|antigravity-proxy)/' <<< "$changed"; then
  echo "[pre-commit] Ports betroffen -> Label-Drift pruefen..."
  # Direkt aufrufen, nicht `bash <datei>.py` — der Shell-Interpreter wuerde das
  # Python-Skript parsen (live gesehen: „syntax error near unexpected token").
  run 60 infra/scripts/port-drift-check.py --quiet \
    || { echo "[pre-commit] Port ohne Label in ports.sh — Commit abgebrochen." >&2; fail=1; }
fi

# --- 3) MAIN-eigenes JS (infra/): node --check ----------------------------
# Nur MAINs eigener JS-Code. Vendorte Proxies (zerokey) haben eigene Checks.
js="$(printf '%s\n' "$changed" | grep -E '^infra/.*\.js$' || true)"
if [ -n "$js" ]; then
  echo "[pre-commit] infra-JS geaendert -> node --check..."
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ -f "$ROOT/$f" ] || continue
    run 30 node --check "$ROOT/$f" >/dev/null 2>&1 \
      || { echo "[pre-commit] Syntaxfehler: $f" >&2; fail=1; }
  done <<< "$js"
fi

# --- 4) Shell-Skripte: shellcheck gegen die eingefrorene Baseline ---------
# Der Hook selbst ist ein .sh — eine Aenderung an ihm triggert diese Pruefung
# mit. `shellcheck-check.sh` ist read-only; nur `--update` schreibt (das ist
# bewusst NICHT im Hook, eine Baseline wird mit Begruendung committet).
if grep -qE '\.sh$' <<< "$changed"; then
  echo "[pre-commit] Shell-Skripte geaendert -> shellcheck (Baseline)..."
  cd "$ROOT" || exit 0
  run 300 bash infra/scripts/shellcheck-check.sh \
    || { echo "[pre-commit] shellcheck hat NEUE Befunde — Commit abgebrochen (siehe oben)." >&2; fail=1; }
fi

# --- 5) Gate-Kommentare: Aussage gegen Config ----------------------------
# Der Coverage-Floor-Scope stand in vier Gate-Dateien falsch (global vs. pro
# Datei) und nichts hielt die Aussagen gegen `infra/coverage-floor.rc`. Reine
# Textpruefung, kein Netz — laeuft nur, wenn eine Gate-Datei oder der Pruefer
# selbst angefasst wurde. Kanonisch ist derselbe Check in verify-codespace.sh.
if grep -qE '^(Makefile|pyproject\.toml|infra/coverage-floor\.rc|\.github/workflows/checks\.yml|infra/scripts/gate-claims-check\.py)$' <<< "$changed"; then
  echo "[pre-commit] Gate-Datei geaendert -> Gate-Claims pruefen..."
  cd "$ROOT" || exit 0
  run 60 infra/scripts/gate-claims-check.py --quiet \
    || { echo "[pre-commit] Kommentar widerspricht der Config (Gate-Claims) — Commit abgebrochen." >&2; fail=1; }
fi

[ "$fail" -eq 0 ] || { echo "[pre-commit] Abbruch — siehe oben." >&2; exit 1; }
echo "[pre-commit] Checks gruen."

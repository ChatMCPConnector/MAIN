{
  "$schema": "https://opencode.ai/v2/cli.json",
  "mouse": false,
  "prompt": {
    "image_preview": true
  },
  "session": {
    "image_preview": true
  },
  "keybinds": {
    "session.page.up": "pageup,ctrl+alt+b",
    "session.page.down": "pagedown,ctrl+alt+f",
    "session.half.page.up": "up,ctrl+alt+u",
    "session.half.page.down": "down,ctrl+alt+d",
    "session.line.up": "ctrl+alt+y",
    "session.line.down": "ctrl+alt+e",
    "prompt.history.previous": "ctrl+up",
    "prompt.history.next": "ctrl+down",
    "variant.cycle": "ctrl+t,ctrl+o",
    "input.move.up": "none",
    "input.move.down": "none",
    "session.parent": "<leader>up"
  }
}

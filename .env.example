# Kopieren zu .env und ausfüllen. .env wird nie committed.
# Inhalt liegt alternativ verschlüsselt im Secrets-Bundle (scripts/secrets.sh lock).

# TokenRouter-API-Key (fuer .opencode/opencode.json):
# in ~/.config/landscape/tokenrouter.key ablegen (ohne Zeilenumbruch), oder:
# TOKENROUTER_API_KEY=sk-...

# TokenRouter-Zugriffstoken fuer System/Infra-Zugriffe:
# SYSTEM_ACCESS_TOKEN=<platzhalter>

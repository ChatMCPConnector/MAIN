# Kopieren zu .env und pro Codespace/Account ausfüllen. .env wird nie committed.
# Beispiel:
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...

# TokenRouter-API-Key (fuer config/opencode/opencode.json):
# in ~/.config/landscape/tokenrouter.key ablegen (ohne Zeilenumbruch), dann
# TOKENROUTER_API_KEY=sk-...

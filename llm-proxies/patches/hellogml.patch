 // ==================== Tool Calling Helpers ====================
 
+// Merge-Funktion: fusioniert einen eingehenden Part-Event mit dem gespeicherten Part.
+// Der Upstream sendet bei init-Events TOKEN-Schnipsel im text-Feld (keine
+// Akkumulation!) und im finish-Event den kompletten Text. Schnipsel werden
+// an den Akkumulat angehaengt; ein finish-Volltext, der mit dem Akkumulat
+// beginnt, ersetzt ihn idempotent.
+function mergePartTexts(existing: any, incoming: any): any {
+  const merged = { ...existing };
+  const incContent = incoming.content;
+  if (!Array.isArray(incContent)) return merged;
+  let oldText = "";
+  const nonTextOld: any[] = [];
+  if (Array.isArray(existing.content)) {
+    for (const item of existing.content) {
+      if (item && item.type === "text") oldText += String(item.text ?? "");
+      else nonTextOld.push(item);
+    }
+  }
+  const incomingStatus = String(incoming.status ?? "");
+  let newText = oldText;
+  for (const item of incContent) {
+    if (!item || item.type !== "text") continue;
+    const fragment = String(item.text ?? "");
+    if (!fragment) continue;
+    if (incomingStatus === "finish" && oldText && fragment.startsWith(oldText)) {
+      newText = fragment;
+    } else {
+      newText = newText + fragment;
+    }
+  }
+  const content: any[] = [];
+  if (newText) content.push({ type: "text", text: newText });
+  for (const item of nonTextOld) content.push(item);
+  for (const item of incContent) {
+    if (item && item.type !== "text") content.push(item);
+  }
+  merged.content = content;
+  return merged;
+}

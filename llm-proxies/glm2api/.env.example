# =========================
# glm2api Example Configuration
# =========================
# Usage:
# 1. Copy this file to `.env`
# 2. Fill in `GLM_REFRESH_TOKEN`, or enable guest mode
# 3. Modify listening address, open models, service authentication as needed

# ---------------------------------
# Service listening configuration
# ---------------------------------
# Service listening address.
# Usually 127.0.0.1 for local use; change to 0.0.0.0 for LAN sharing.
HOST=127.0.0.1

# Service port.
# OpenAI SDK defaults typically connect to http://127.0.0.1:8000/v1, so the default stays at 8000.
PORT=8000

# OpenAI-compatible API prefix.
# Usually keep /v1, unless you already have reverse proxy rules.
API_PREFIX=/v1

# Log level: DEBUG / INFO / WARNING / ERROR
# Change to DEBUG to see detailed request processing.
LOG_LEVEL=INFO

# Debug fire-hose mode.
# true: Automatically switches to DEBUG and prints almost all debug info, including raw inbound requests, raw upstream requests/responses, raw SSE, tool call conversion, etc.
DEBUG_DUMP_ALL=false

# Upstream request timeout in seconds.
# The GLM web side can be slow with long answers and web-search scenarios, so a default of 120 seconds is safer.
REQUEST_TIMEOUT_SECONDS=120

# CORS allowed origins.
# Keep * for local frontend debugging; set a specific domain to restrict origins.
CORS_ALLOW_ORIGIN=*

# ---------------------------------
# Service self-authentication (optional)
# ---------------------------------
# If you want others to require a Bearer Token when accessing the local proxy, configure it here.
# Multiple keys separated by English commas, for example:
# SERVER_API_KEYS=sk-local-1,sk-local-2
# Leave empty to not authenticate visitors.
SERVER_API_KEYS=

# ---------------------------------
# GLM / Zhipu Qingyan Upstream Configuration
# ---------------------------------
# Multi-account token file path.
# One refresh_token per line; the program prioritizes this account list.
# When a request fails for an account, it automatically switches to the next line to continue trying.
GLM_TOKEN_FILE=token.txt

# Single-account fallback configuration.
# Only uses the refresh_token here if there is no token.txt.
# If the upstream returns a new refresh_token, it is automatically written back to the current `.env` file in single-account mode;
# in multi-account mode, it is written back to the corresponding account line in token.txt.
GLM_REFRESH_TOKEN=

# Explicitly enable guest token.
# true: Ignore token.txt and GLM_REFRESH_TOKEN, use guest token directly
# false: Normally prioritize refresh_token; but if no token is configured at all, it will automatically fall back to guest mode
# Guest mode automatically creates an equivalent number of guest account slots according to GLM_MAX_CONCURRENCY
GLM_USE_GUEST_REFRESH_TOKEN=false

# GLM Web base URL.
# Default corresponds to the chatglm Web interface in docs; modification is not recommended.
GLM_BASE_URL=https://chatglm.cn/chatglm

# Default assistant_id
# The one used in docs is 65940acff94777010aa6b796
# Keep the default in most scenarios; if you have your own dedicated assistant, you can replace it
GLM_ASSISTANT_ID=65940acff94777010aa6b796

# Drawing assistant_id used by default for image generation interface
GLM_IMAGE_ASSISTANT_ID=65a232c082ff90a2ad2f15e2

# Model name used for the image endpoints when the request omits "model".
# It is also listed in /v1/models as "glm-image-1".
GLM_IMAGE_MODEL_NAME=glm-image-1

# Whether to delete GLM session after each answer.
# true: Cleaner, reduces web-side chat record backlog
# false: Keep session for easier troubleshooting on the upstream web side
GLM_DELETE_CONVERSATION=true

# Keep the upstream web session alive and reuse its conversation id for
# follow-up requests (GLM_CONVERSATION_FILE persists it across restarts).
# true: fewer fresh sessions, more web-side chat history
# false: every request is a fresh upstream conversation (default)
GLM_PERSISTENT_CONVERSATION=false

# File used to persist the upstream conversation id when
# GLM_PERSISTENT_CONVERSATION=true (relative paths resolve next to this .env).
GLM_CONVERSATION_FILE=conversation.txt

# Explicit conversation id to use for the next request (wins over the
# persisted file; empty = use persisted/auto). Useful for resuming a
# specific upstream chat after a restart.
GLM_CONVERSATION_ID=

# Number of upstream execution slots allowed to be occupied simultaneously.
# Code default is 3 (suitable for local multi-client concurrency); this file
# ships 100 because guest mode pre-creates one guest slot per concurrency
# value. If your account has strict risk control, adjust to 1.
# This value also determines how many independent guest account slots will be pre-created.
GLM_MAX_CONCURRENCY=100

# Maximum waiting time for multi-request queuing, in seconds.
# When concurrent requests exceed the number of execution slots above, it waits here for idle slots.
GLM_QUEUE_WAIT_TIMEOUT_SECONDS=600

# When GLM returns "Please wait for other dialogue generation to complete", how many times to automatically retry at most.
# This retry is mainly used to cover the situation where "there are other sessions generating on the web side".
GLM_BUSY_MAX_RETRIES=30

# How long to wait between two retries when triggering the above busy retry, in seconds.
GLM_BUSY_RETRY_INTERVAL_SECONDS=2

# When the guest token request fails, how many times to automatically re-fetch the guest token and retry at most.
GLM_GUEST_MAX_RETRIES=3

# When the upstream aborts an in-flight stream with a transient error (e.g. code 10025
# "stream request error"), how many times to transparently restart the stream before
# failing the request. Retries only happen while no visible content was sent yet.
GLM_STREAM_ERROR_MAX_RETRIES=2

# How long to wait between transient stream error retries, in seconds.
GLM_STREAM_ERROR_RETRY_INTERVAL_SECONDS=1

# How many times a completely empty upstream round (no text, no reasoning,
# no tool call) is silently retried with a fresh conversation before the
# empty answer is forwarded to the client.
GLM_EMPTY_RESPONSE_MAX_RETRIES=2

# History compression budget in characters (0 disables). Histories larger
# than this are compacted (older turns summarized, assistant+tool pairs are
# never split) before being sent upstream. On upstream error code 10040
# ("context exceeded") the budget is automatically halved and retried
# (minimum 20000).
GLM_HISTORY_MAX_CHARS=120000

# Max follow-up rounds for a model that called a blocked/undeclared tool
# (e.g. open_url, browse, execute_sandbox_code). The proxy injects an
# explicit "tool not available" turn so the model can correct itself.
GLM_BLOCKED_TOOL_FOLLOW_UPS=2

# Tool blacklist, multiple names separated by English commas.
# These tools will not be injected into the prompt; even if the model still
# outputs the corresponding call, it will be discarded on the server side.
# NB: BLOCKED_NATIVE_TOOL_NAMES in tool_protocol.py is ALWAYS enforced
# (open_url, browse, web.search, execute_sandbox_code, ...) —
# the list here is additional.
BLOCKED_TOOL_NAMES=open_url,open_ul,browser.open,web.run,web.open,web.search,web_search,browse,open_link

# Custom User-Agent.
# Only change this when you explicitly know you want to impersonate another browser.
GLM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/143.0.0.0 Safari/537.36 Edg/143.0.0.0

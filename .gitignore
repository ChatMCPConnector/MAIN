# Secrets & Wegwerfbares - das kommt NICHT mit ins Git
.env
*.db
*.db-shm
*.db-wal
node_modules/
.venv/
__pycache__/
*.log
*.pid

# Secrets ( Verschluesselt via secrets.sh, Klartext nie committen)
.secrets/

# Reproducible browser runtime and sensitive local browser profile
.runtime/

# glm2api-Runtime im Repo (Code ist committet, das hier nicht):
llm-proxies/glm2api/.env
llm-proxies/glm2api/log/
llm-proxies/glm2api/token.txt
llm-proxies/glm2api/conversation.txt
llm-proxies/dist/glm2api-bundle/
# Build-Artefakt: wird von llm-proxies/scripts/build-bundle.sh reproduzierbar
# erzeugt, gehoert nicht in den Index (vorher getrackt, 2026-09-28 entfernt):
llm-proxies/dist/glm2api-bundle.zip

# scratch-statusbericht einer sitzung, kein ergebnis (AGENTS.md § 5: erledigte
# arbeit gehoert nach /workspaces/MAIN, dieser file ist ein zwischenstand):
/handoff.mc

# ZeroKey-Runtime im Repo (Code ist committet, das hier nicht).
# temp/users.json enthaelt die ChatGPT-Cookies + das Sentinel-Token: Secret,
# niemals committen. Wiederherstellung laeuft ueber config/secrets.enc
# (zerokey-users.json) -> ~/.config/landscape/ -> hier; siehe infrastructure.md.
llm-proxies/zerokey/temp/
llm-proxies/zerokey/data/
llm-proxies/zerokey/node_modules/

# Freebuff-Projektzustand (lokaler Projekt-Scope, enthaelt u.a. die project-id).
# Stand 2026-10-01 nur in .git/info/exclude — das ist NICHT versioniert, in
# einem frischen Clone also trackbar.
/.freebuff/

# Root-Toolcaches aus Laeufen im Repo-Root (mypy/pytest/ruff). Ebenfalls vorher
# nur in .git/info/exclude.
.mypy_cache/
.pytest_cache/
.ruff_cache/

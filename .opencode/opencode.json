{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "{file:~/.config/landscape/tokenrouter.key}"
      },
      "models": {
        "z-ai/glm-5.3-free": {
          "name": "GLM 5.3 (free)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "whitelist": [
        "nvidia/nemotron-3-ultra-550b-a55b"
      ],
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{file:~/.config/landscape/nvidia-nim.key}"
      },
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron 3 Ultra 550B",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    },
    "xinjianya": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "XinJianYa (newapi)",
      "options": {
        "baseURL": "https://xn--kiv260fv3i.cn/v1",
        "apiKey": "{file:~/.config/landscape/xinjianya.key}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "cost": {
            "input": 2,
            "output": 16,
            "cache_read": 2
          },
          "options": {
            "reasoningEffort": "max",
            "textVerbosity": "high"
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
            "moonshotai/kimi-k3": {
              "name": "Kimi K3",
              "reasoning": true,
              "cost": {
                "input": 20,
                "output": 20,
                "cache_read": 20
              },
              "options": {
                "reasoningEffort": "max"
              },
              "variants": {
                "low": {
                  "reasoningEffort": "low"
                },
                "high": {
                  "reasoningEffort": "high"
                },
                "max": {
                  "reasoningEffort": "max"
                }
              }
            },
            "grok-4.6": {
              "name": "Grok 4.6",
              "reasoning": true,
              "cost": {
                "input": 20,
                "output": 20,
                "cache_read": 20
              },
              "options": {
                "reasoningEffort": "xhigh"
              },
              "variants": {
                "low": {
                  "reasoningEffort": "low"
                },
                "medium": {
                  "reasoningEffort": "medium"
                },
                "high": {
                  "reasoningEffort": "high"
                },
                "xhigh": {
                  "reasoningEffort": "xhigh"
                }
              }
            }
          }
        },

    "google": {
      "name": "Google Gemini",
      "options": {
        "apiKey": "{file:~/.config/landscape/gemini.key}"
      },
      "whitelist": [
        "gemini-3.7-flash",
        "gemini-3.6-flash",
        "gemini-3.5-flash-lite"
      ]
    },
    "glm2api": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "glm2api",
      "options": {
        "baseURL": "http://127.0.0.1:8001/v1",
        "apiKey": "local"
      },
      "models": {
        "glm-5.3-think": {
          "name": "GLM-5.3",
          "reasoning": true,
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "max"
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "antigravity": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Antigravity OAuth Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:9878/v1",
        "apiKey": "antigravity-secret-6fe2eaa404e1c91bfa0fec01e74ddcc1"
      },
      "models": {
        "gemini-3.5-flash-light": {
          "name": "Gemini 3.5 Flash Light",
          "reasoning": true,
          "options": {
            "reasoningEffort": "low"
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash",
          "reasoning": true,
          "options": {
            "reasoningEffort": "low"
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        },
        "gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro",
          "reasoning": true,
          "options": {
            "reasoningEffort": "low"
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "high": { "reasoningEffort": "high" }
          }
        }
      }
    },
    "gemini-web": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gemini Web (Google AI Pro)",
      "options": {
        "baseURL": "http://127.0.0.1:8083/v1",
        "apiKey": "sk-gemini-pro-local-2026"
      },
      "models": {
        "gemini-3.1-pro-thinking": {
          "name": "Gemini 3.1 Pro Thinking (Web)",
          "reasoning": true,
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gemini-3.8-flash-thinking": {
          "name": "Gemini 3.8 Flash Thinking (Web)",
          "reasoning": true,
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gemini-3.5-flash-lite-thinking": {
          "name": "Gemini 3.5 Flash-Lite Thinking (Web)",
          "reasoning": true,
          "limit": {
            "context": 128000,
            "output": 16384
          }
        }
      }
    }
  },
  "model": "tokenrouter/z-ai/glm-5.3-free",
  "small_model": "tokenrouter/z-ai/glm-5.3-free",
  "disabled_providers": [
    "github-copilot"
  ],
  "default_agent": "build",
  "permission": "allow",
  "lsp": true,
  "mcp": {
    "opencode-sessions": {
      "type": "local",
      "command": [
        "node",
        "/workspaces/MAIN/infra/mcp/opencode-sessions-mcp.js"
      ],
      "enabled": true,
      "environment": {}
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 83400
  },
  "agent": {
    "build": {
      "color": "warning"
    },
    "plan": {
      "color": "accent"
    }
  }
}

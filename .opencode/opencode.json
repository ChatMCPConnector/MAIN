{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "{file:~/.config/landscape/tokenrouter.key}"
      },
      "models": {
        "z-ai/glm-5.3-free": {
          "name": "GLM 5.3 (free)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "tokenrouter/z-ai/glm-5.3-free",
  "permission": "allow",
  "agent": {
    "build": {
      "color": "warning"
    },
    "plan": {
      "color": "accent"
    }
  }
}

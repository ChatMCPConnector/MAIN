{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "whitelist": [
        "nvidia/nemotron-3-ultra-550b-a55b"
      ],
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{file:~/.config/landscape/nvidia-nim.key}"
      },
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron 3 Ultra 550B",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    },
    "xinjianya": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "XinJianYa (newapi)",
      "options": {
        "baseURL": "https://xn--kiv260fv3i.cn/v1",
        "apiKey": "{file:~/.config/landscape/xinjianya.key}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "cost": {
            "input": 2,
            "output": 16,
            "cache_read": 2
          },
          "options": {
            "reasoningEffort": "max",
            "textVerbosity": "high"
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "glm2api": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "glm2api",
      "options": {
        "baseURL": "http://127.0.0.1:8001/v1",
        "apiKey": "local"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM-5.3",
          "reasoning": true,
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "max"
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "antigravity": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Antigravity OAuth Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:9878/v1",
        "apiKey": "antigravity-secret-6fe2eaa404e1c91bfa0fec01e74ddcc1"
      },
      "models": {
        "gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash",
          "reasoning": true,
          "options": {
            "model": "gemini-3.8-flash-high",
            "reasoningEffort": "high"
          },
          "variants": {
            "high": { "model": "gemini-3.8-flash-high", "reasoningEffort": "high" },
            "medium": { "model": "gemini-3.8-flash-medium", "reasoningEffort": "medium" },
            "low": { "model": "gemini-3.8-flash-low", "reasoningEffort": "low" }
          },
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        },
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "reasoning": true,
          "options": {
            "reasoningEffort": "medium"
          },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          },
          "limit": {
            "context": 100000,
            "output": 16384
          }
        }
      }
    },
    "opencode": {
      "whitelist": [
        "muse-spark-1.3",
        "muse-spark-1.3-contributor-free"
      ]
    }
  },
  "model": "antigravity/gemini-3.8-flash",
  "disabled_providers": [
    "github-copilot"
  ],
  "default_agent": "build",
  "permission": "allow",
  "lsp": true,
  "mcp": {
    "opencode-sessions": {
      "type": "local",
      "command": [
        "node",
        "/workspaces/MAIN/infra/mcp/opencode-sessions-mcp.js"
      ],
      "enabled": true,
      "environment": {}
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000
  },
  "agent": {
    "build": {
      "color": "warning"
    },
    "plan": {
      "color": "accent"
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "whitelist": [
        "nvidia/nemotron-3-ultra-550b-a55b"
      ],
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{file:~/.config/landscape/nvidia-nim.key}"
      },
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron 3 Ultra 550B",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    },
    "xinjianya": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "XinJianYa (newapi)",
      "options": {
        "baseURL": "https://xn--kiv260fv3i.cn/v1",
        "apiKey": "{file:~/.config/landscape/xinjianya.key}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "cost": {
            "input": 2,
            "output": 16,
            "cache_read": 2
          },
          "options": {
            "reasoningEffort": "max",
            "textVerbosity": "high"
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "glm2api": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "glm2api",
      "options": {
        "baseURL": "http://127.0.0.1:8001/v1",
        "apiKey": "local"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM-5.3",
          "reasoning": true,
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "max"
          },
          "variants": {
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "freebuff": {
      "npm": "@ai-sdk/openai-compatible",

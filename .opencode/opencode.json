{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "{file:~/.config/landscape/tokenrouter.key}"
      },
      "models": {
        "z-ai/glm-5.3-free": {
          "name": "GLM 5.3 (free)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    },
    "bananarouter": {
      "npm": "file:.opencode/bananarouter-adapter",
      "name": "BananaRouter",
      "options": {
        "apiKey": "{file:~/.config/landscape/bananarouter.key}"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-5.3": {
          "name": "GLM 5.3",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "tokenrouter/z-ai/glm-5.3-free",
  "default_agent": "build",
  "permission": "allow",
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 83400
  },
  "agent": {
    "build": {
      "color": "warning"
    },
    "plan": {
      "color": "accent"
    }
  }
}
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "{file:~/.config/landscape/tokenrouter.key}"
      },
      "models": {
        "z-ai/glm-5.3-free": {
          "name": "GLM 5.3 (free)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "whitelist": [
        "deepseek-ai/deepseek-v4-pro-0813",
        "deepseek-ai/deepseek-v4-flash-0731",
        "nvidia/nemotron-3-ultra-550b-a55b"
      ],
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{file:~/.config/landscape/nvidia-nim.key}"
      },
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron 3 Ultra 550B",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        "deepseek-ai/deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "deepseek-ai/deepseek-v4-pro-0813": {
          "name": "DeepSeek V4 Pro 0813",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    },
    "xinjianya": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "XinJianYa (newapi)",
      "options": {
        "baseURL": "https://xn--kiv260fv3i.cn/v1",
        "apiKey": "{file:~/.config/landscape/xinjianya.key}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "cost": {
            "input": 2,
            "output": 16,
            "cache_read": 2
          },
          "options": {
            "reasoningEffort": "max",
            "textVerbosity": "high"
          },
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "moonshotai/kimi-k3": {
          "name": "Kimi K3",
          "reasoning": true,
          "cost": {
            "input": 20,
            "output": 20,
            "cache_read": 20
          },
          "options": {
            "reasoningEffort": "max"
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "deepseek-ai/deepseek-v4-pro-0813": {
          "name": "DeepSeek V4 Pro 0813",
          "reasoning": true,
          "cost": {
            "input": 20,
            "output": 20,
            "cache_read": 20
          },
          "limit": {
            "context": 128000,
            "output": 8192
          },
          "options": {
            "reasoningEffort": "max"
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "glm2api": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "glm2api (chatglm.cn guest-pool)",
      "options": {
        "baseURL": "http://127.0.0.1:8001/v1",
        "apiKey": "local"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM 5.3",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-5.3-think": {
          "name": "GLM 5.3 Think",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    },
    "hellogml": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "HelloGML (chatglm.cn worker)",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "sk-test-local-1"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM 5.3",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-5.3-think": {
          "name": "GLM 5.3 Think",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    },
    "chat2apilocal": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Chat2API local (electron)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local"
      },
      "models": {
        "GLM-5.3": {
          "name": "GLM 5.3",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "GLM-5.3-Think": {
          "name": "GLM 5.3 Think",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "tokenrouter/z-ai/glm-5.3-free",
  "small_model": "tokenrouter/z-ai/glm-5.3-free",
  "disabled_providers": [
    "github-copilot"
  ],
  "default_agent": "build",
  "permission": "allow",
  "lsp": true,
  "mcp": {
    "opencode-sessions": {
      "type": "local",
      "command": ["node", "/workspaces/MAIN/infra/mcp/opencode-sessions-mcp.js"],
      "enabled": true,
      "environment": {}
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 83400
  },
  "agent": {
    "build": {
      "color": "warning"
    },
    "plan": {
      "color": "accent"
    }
  }
}
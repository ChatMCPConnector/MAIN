{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "{file:~/.config/landscape/tokenrouter.key}"
      },
      "models": {
        "z-ai/glm-5.3-free": {
          "name": "GLM 5.3 (free)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    },
    "glmfree": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GLM Free (z.ai bridge)",
      "options": {
        "baseURL": "https://glm.cognix.sryze.cc/v1",
        "apiKey": "Waguri"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM 5.3 Thinking (free)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-5.2": {
          "name": "GLM 5.2 Thinking (free)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "x-preview-l": {
          "name": "GLM 5.3 Flash Vision (free)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "GLM-5v-Turbo": {
          "name": "GLM 5V Turbo Vision (free)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-4.7": {
          "name": "GLM 4.7 (free)",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "tokenrouter/z-ai/glm-5.3-free",
  "default_agent": "build",
  "permission": "allow",
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 83400
  },
  "agent": {
    "build": {
      "color": "warning"
    },
    "plan": {
      "color": "accent"
    }
  }
}